# ==========================================
# FCIT 2.0 — Environment Configuration
# Copy to server/.env and client/.env as needed
# Never commit real secrets to version control
# ==========================================

# --- Backend (server/.env) ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection
# Local MongoDB Community Server OR MongoDB Atlas M0 Free Tier URI
MONGODB_URI=mongodb://127.0.0.1:27017/fcit_db

# Development convenience: if no external mongod is running locally,
# boot a persistent local MongoDB instance backed by server/.data/db
ENABLE_LOCAL_MONGO_FALLBACK=true

# Authentication & Security
# Generate a strong random 64+ character hex string:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_random_64_char_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=fcit_session

# File Storage Provider ("local" zero-cost default, or optional "cloudinary" free tier)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fcit-archive

# Optional Free Email Integration (leave blank to store in MongoDB & use mailto fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=

# Initial Super Admin Seeding (used ONLY by `npm run seed:admin` in server/)
# Never ship shared default credentials in code
SEED_ADMIN_NAME=FCIT Super Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Frontend (client/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=fcit.hbtu@placeholder.invalid
