# FCIT Server Environment Configuration
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection (Local or Atlas M0 Free Tier)
MONGODB_URI=mongodb://127.0.0.1:27017/fcit_db

# Development only: fallback to persistent embedded MongoDB if 127.0.0.1:27017 is unreachable
ENABLE_LOCAL_MONGO_FALLBACK=true

# Authentication (Minimum 32 characters, recommended 64-char hex)
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=fcit_session

# File Storage Provider: "local" (default) or "cloudinary"
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Cloudinary (Optional, for serverless / ephemeral hosting like Render free tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fcit-archive

# SMTP Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=

# Initial Super Admin Seed (Optional - used by `npm run seed:admin`)
SEED_ADMIN_NAME=FCIT Super Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
